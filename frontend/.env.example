# Where the Vite dev server proxies /api and /socket.io (development only).
VITE_DEV_API_TARGET=http://localhost:5000

# Production build only: absolute API origin when the SPA is hosted separately from the API.
# Leave empty when the API is served from the same origin (e.g. behind one reverse proxy).
VITE_API_URL=

# Must match the backend CLINIC_TIMEZONE so "today" means the same day on both sides.
VITE_CLINIC_TIMEZONE=Asia/Kolkata
