# --- Server ---
NODE_ENV=development
PORT=5000
LOG_LEVEL=info

# --- Database ---
# Atlas (recommended; supports transactions):
#   mongodb+srv://<user>:<password>@<cluster>/emr?retryWrites=true&w=majority
# Local single-node replica set (via docker compose in the repo root):
MONGO_URI=mongodb://localhost:27017/emr?replicaSet=rs0&directConnection=true

# --- Auth (generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))") ---
JWT_ACCESS_SECRET=replace-with-a-long-random-string-of-at-least-32-chars
JWT_REFRESH_SECRET=replace-with-a-different-long-random-string-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN_DAYS=7
BCRYPT_SALT_ROUNDS=12
# strict | lax | none   ("none" only if frontend and API are on different sites; requires HTTPS)
COOKIE_SAME_SITE=lax

# --- CORS (comma-separated list of allowed frontend origins) ---
CORS_ORIGINS=http://localhost:5173

# --- Clinic ---
CLINIC_TIMEZONE=Asia/Kolkata

# --- Seed script only ---
SEED_ADMIN_EMAIL=admin@emr.local
SEED_PASSWORD=Password@123
